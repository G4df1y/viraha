{
  "name": "@viraha/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@viraha/companion-core": "workspace:*",
    "expo": "~57.0.4",
    "expo-build-properties": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.test.tsx"
    ]
  }
}
