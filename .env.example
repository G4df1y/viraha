# LLM provider. Set at least one key.
DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Default model
DEFAULT_MODEL=deepseek-chat

# Companion plugin packs (semicolon-separated absolute paths)
COMPANION_PACK_DIRS=

# ===== 飞书自建应用(双向,WebSocket 长连接模式) =====
# 从 https://open.feishu.cn/app 创建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 连接模式:websocket(默认,推荐,无需公网) 或 webhook(备选,需公网 URL)
FEISHU_CONNECTION_MODE=websocket
# webhook 模式专用(websocket 模式不需要):
#   FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   FEISHU_WEBHOOK_PORT=3001

# ===== QQ 官方 Bot(双向,WebSocket 长连接模式) =====
# 从 https://q.qq.com 开通机器人后获取
QQ_BOT_APPID=xxxxxxxxxx
# ClientSecret(推荐,用于动态获取 access_token,启用双向 WebSocket)
QQ_BOT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 旧版静态 token(可选,仅用于 push-only 降级模式)
# QQ_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 默认推送的群 open_id(可选,发送群消息时用)
QQ_GROUP_OPENID=

# ===== Web 服务端口(默认 3000) =====
PORT=3000

# ===== 主动消息调度频率(默认 2 小时,毫秒) =====
PRESENCE_CHECK_INTERVAL_MS=7200000
